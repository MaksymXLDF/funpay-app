{
  "name": "funpay-desktop",
  "version": "1.0.1",
  "description": "FunPay desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.example.funpay",
    "productName": "FunPay",
    "win": {
      "target": "nsis",
      "artifactName": "FunPay.exe V${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
